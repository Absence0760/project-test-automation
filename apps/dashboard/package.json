    "lint": "eslint src/"
  },
  "dependencies": {
    "@bettertest/reporter": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
