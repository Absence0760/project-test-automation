{
  "name": "@bettertest/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Better Test Automation reporting and analytics dashboard — Flakey integration",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
