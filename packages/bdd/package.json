{
  "name": "@bettertest/bdd",
  "version": "0.1.0",
  "description": "First-class Gherkin/BDD engine — native parser, not a Cucumber plugin",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
