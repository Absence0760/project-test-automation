{
  "name": "@bettertest/runner",
  "version": "0.1.0",
  "description": "Better Test Automation runner — orchestration, parallel execution, and fail-fast heuristics",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@bettertest/selectors": "workspace:*",
    "@bettertest/bdd": "workspace:*",
    "@bettertest/reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
